# Production environment template — copy to repo root as `.env` and fill values.
# Do not commit `.env`. Generate secrets with: openssl rand -hex 32

NODE_ENV=production

# Public site (Caddy obtains HTTPS certificate automatically)
DOMAIN=tracker.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL (docker-compose.prod.yml)
POSTGRES_USER=baby
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=baby_tracker

# App ports (internal; Caddy exposes 80/443)
PORT_API=3001
PORT_WEB=3000

# Browser calls API through Caddy /api prefix (baked into Next.js at `docker build`; change DOMAIN → rebuild web)
NEXT_PUBLIC_API_URL=https://tracker.example.com/api

# Database URL is overridden in compose; keep for local tooling if needed
DATABASE_URL=postgresql://baby:change_me_strong_password@postgres:5432/baby_tracker

# Auth / setup (generate unique values)
JWT_SECRET=
SETUP_TOKEN=

# Telegram — webhook is handled by API in production (do not run bot polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=
# Optional dedicated webhook secret; defaults to TELEGRAM_BOT_SECRET
TELEGRAM_WEBHOOK_SECRET=

# LLM (optional until worker jobs are enabled)
OPENAI_API_KEY=

# Uploads path inside API container (volume mount in compose)
UPLOADS_DIR=/data/uploads

# Internal API URL for Telegram webhook handler
API_BASE_URL=http://api:3001
